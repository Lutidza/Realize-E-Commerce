    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "payload": "^3.86.0",
    "pg": "^8.22.0",
    "prism-react-renderer": "^2.4.1",
    "qs-esm": "^8.0.1",
    "react": "^19.2.7",
